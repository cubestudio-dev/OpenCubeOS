# Open Cube OS NAK - gitignore for the NAK tree.
# Note: final artifacts (ISO / zip / ELF) are deliberately NOT ignored
# here - they are release evidence and go to GitHub Releases.

# Compiler / linker intermediates
*.o
*.d

# Python cache (no Python is used by the NAK build)
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# Logs
*.log
