# Open Cube OS NAK - gitignore for the NAK tree.
#
# Final artifacts (ISO / source zip / ELF) are build products living
# under build/ trees and never enter git: they are released through
# GitHub Releases (opencubenak-WP-01-tree.iso, built by ocos/Makefile;
# opencubenak-WP-01-tree-src.zip, built by the root Makefile from a
# git archive of HEAD).

# Build trees (every component writes into its own build/)
build/

# Compiler / linker intermediates
*.o
*.d

# Python cache (no Python is used by the NAK build)
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# Logs
*.log
