# Open Cube OS NAK - gitignore for the NAK tree.
# Only real build products are ignored; everything tracked stays tracked.

# Compiler / linker products
*.o
*.d
*.elf

# Python cache
__pycache__/
*.pyc

# OS / editor noise
.DS_Store
Thumbs.db
*~
*.swp
.vscode/
.idea/

# Logs
*.log
