# Open Cube OS - 3.0.0-WP02-ocire_recovery
# File: ocire/grub-dual.cfg.in
# Purpose: TEMPLATE for the dual-boot disk menu (hd0).  The build
#          script (tools/make_ocire_disk.sh) fills in the OCIRE
#          kernel blocklist (@KERN_LBA@ / @KERN_SECTORS@ - the
#          /BOOT/OCIRE.ELF data start on the FAT12 recovery volume)
#          and writes the result to hd0 p1 /boot/grub/grub.cfg AND
#          to the golden image copy (they are byte-identical, so a
#          `repair` restores exactly this menu).
#
#          WP-02 menu structure (3 entries):
#            1 (default, timeout) - OCIRE boot supervisor: arms the
#               60 s watchdog, records WAIT_BOOT_SIGNAL and hands the
#               machine to OCOS.  When the previous boot never
#               signalled, this entry shows the crash notice and
#               reboots into the full recovery shell instead.
#            2 - OCIRE full recovery shell (manual pick: logread /
#               syscheck / repair / return).
#            3 - Open Cube OS direct boot (skip OCIRE entirely; OCOS
#               still sends its boot signal to the mailbox).
#
#          The video recipe (loadfont + gfxterm + gfxmode/gfxpayload)
#          mirrors the OCOS ISO: GRUB only fills the RGB framebuffer
#          tag the kernels request when gfxterm runs on that surface.

insmod serial
insmod terminal
insmod vbe
insmod video
insmod video_fb
insmod gfxterm
insmod font
loadfont (hd0,msdos1)/boot/grub/fonts/unicode.pf2
serial --unit=0 --speed=115200
terminal_output serial gfxterm
terminal_input serial console
set color_normal=light-gray/black
set color_highlight=black/light-gray
set gfxmode=800x600x32
set gfxpayload=keep
set timeout=8
set default=0

menuentry "OCIRE boot supervisor (watchdog -> Open Cube OS)" {
  # Whole-disk blocklist onto the FAT12 recovery volume (the 0xEE
  # shadow partition has no GRUB-visible partition path).
  multiboot2 (hd1)@KERN_LBA@+@KERN_SECTORS@ ocire.mode=sup
  boot
}

menuentry "OCIRE recovery (full shell)" {
  multiboot2 (hd1)@KERN_LBA@+@KERN_SECTORS@ ocire.mode=full
  boot
}

menuentry "Open Cube OS (direct boot)" {
  multiboot2 (hd0,msdos1)/boot/opencube.elf oc.slot=ISO
  module2 (hd0,msdos1)/boot/opencube.elf self
  boot
}
