# Open Cube OS - 3.0.0-WP-01-ocire-core
# File: ocire/ocire.mk
# Purpose: Build targets for the OCIRE independent recovery kernel.
#
# Included once from the top-level Makefile (inside the x86_64 branch).
# OCIRE is an INDEPENDENT kernel: this file compiles only ocire/*.c and
# ocire/*.S with its own include paths (no OCOS kernel headers), links
# with its own linker script (ocire/linker_ocire.ld) and produces its
# own boot image (build/ocire/ocire.iso).
#
# Targets:
#   make ocire-kernel   - OCIRE ELF  (build/ocire/ocire.elf)
#   make ocire-iso      - bootable OCIRE ISO (BIOS + UEFI)
#   make ocire-disk     - dual-boot test disk + standalone OCIRE disk
#   make ocire-run-bios - boot the OCIRE ISO in QEMU (SeaBIOS)
#   make ocire-run-uefi - boot the OCIRE ISO in QEMU (OVMF)
#   make ocire-test     - automated QEMU test battery (tools/run_ocire_tests.py)

OCIRE_DIR := $(OC_ROOT)/ocire
OCIRE_OUT := $(BUILD)/ocire

OCIRE_VERSION ?= 3.0.0-WP-02

# ---- WP-02: the ring-3 log agent (OCOS L1 ABI, OCIRE's asset) -----
# Compiled like an l1apps/ C program (gcc freestanding + user.ld @
# 0x400000, int 0x80 syscalls) but shipped as a STANDALONE ELF on the
# recovery volume (/AGENT/AGENT.ELF) - never embedded in either
# kernel.  The supervisor injects it at kexec; OCOS spawns it as the
# ocire_guard-protected process.
OCIRE_AGENT     := $(OCIRE_OUT)/agent.elf
OCIRE_AGENT_SRC := $(OCIRE_DIR)/agent/ocire_agent.c
OCIRE_AGENT_OBJ := $(OCIRE_OUT)/ocire_agent.o

OCIRE_C := $(wildcard $(OCIRE_DIR)/*.c)
OCIRE_S := $(wildcard $(OCIRE_DIR)/*.S)

OCIRE_OBJ_C := $(patsubst $(OCIRE_DIR)/%.c,$(OCIRE_OUT)/%.o,$(OCIRE_C))
OCIRE_OBJ_S := $(patsubst $(OCIRE_DIR)/%.S,$(OCIRE_OUT)/%.o,$(OCIRE_S))
OCIRE_OBJ  := $(OCIRE_OBJ_C) $(OCIRE_OBJ_S)

OCIRE_ELF  := $(OCIRE_OUT)/ocire.elf
OCIRE_ISO  := $(OCIRE_OUT)/ocire.iso

# Own freestanding flags: no OCOS include paths leak in (independence
# rule of WP-01); the version reaches the sources only through the
# cmp-guarded generated header below (same recompile-trigger pattern
# the OCOS kernel uses for its -D version macros).
OCIRE_CFLAGS := -ffreestanding -fno-stack-protector -fno-pie -fno-pic \
		-mno-red-zone -mno-sse -mno-mmx -mno-3dnow -mcmodel=kernel \
		-fno-asynchronous-unwind-tables -Wall -Wextra -Werror \
		-O2 -g -std=gnu11 -I$(OCIRE_DIR) -I$(OCIRE_DIR)/generated \
		-MMD -MP

OCIRE_VERSION_GEN := $(OCIRE_DIR)/generated/ocire_version_gen.h
$(OCIRE_VERSION_GEN): FORCE
	@mkdir -p $(OCIRE_DIR)/generated
	@{ echo '/* Generated by the Makefile - OCIRE build stamp.'; \
	   echo ' * Version source of truth: OCIRE_VERSION / OC_KERNEL_BUILD'; \
	   echo ' * (the cmp guard keeps unchanged stamps from thrashing mtimes) */'; \
	   echo '#define OCIRE_STAMP "OCIRE $(OCIRE_VERSION) (build $(OC_KERNEL_BUILD))"'; \
	 } > $(OCIRE_VERSION_GEN).tmp
	@if ! cmp -s $(OCIRE_VERSION_GEN).tmp $(OCIRE_VERSION_GEN); then \
	   mv -f $(OCIRE_VERSION_GEN).tmp $(OCIRE_VERSION_GEN); \
	   echo "make: regenerated $$@ ($(OCIRE_VERSION))"; \
	 else rm -f $(OCIRE_VERSION_GEN).tmp; fi

$(OCIRE_OBJ_C): $(OCIRE_VERSION_GEN)

# Static pattern rules: they match before the generic $(BUILD)/%.o rule
# in the including Makefile, so OCIRE objects always build with
# OCIRE_CFLAGS, never with the OCOS KERNEL flags.
$(OCIRE_OBJ_C): $(OCIRE_OUT)/%.o: $(OCIRE_DIR)/%.c
	@mkdir -p $(dir $@)
	$(OC_CC) $(OCIRE_CFLAGS) -c $< -o $@

$(OCIRE_OBJ_S): $(OCIRE_OUT)/%.o: $(OCIRE_DIR)/%.S
	@mkdir -p $(dir $@)
	$(NASM) $(ASFLAGS) $< -o $@

$(OCIRE_ELF): $(OCIRE_OBJ) $(OCIRE_DIR)/linker_ocire.ld
	@mkdir -p $(OCIRE_OUT)
	$(LD) -n -nostdlib -T $(OCIRE_DIR)/linker_ocire.ld \
	      -z max-page-size=0x1000 -z noexecstack -o $@ $(OCIRE_OBJ)
	strip --strip-debug $@

$(OCIRE_ISO): $(OCIRE_ELF) $(OCIRE_DIR)/grub-ocire.cfg \
              $(OC_ROOT)/tools/build_ocire_iso.sh
	bash $(OC_ROOT)/tools/build_ocire_iso.sh

.PHONY: ocire-kernel ocire-iso ocire-disk ocire-run-bios ocire-run-uefi \
        ocire-run-bios-gui ocire-run-uefi-gui ocire-test ocire-dual-test \
        ocire-shell-test ocire-agent

ocire-agent: $(OCIRE_AGENT)
	@echo "ocire-agent: $(OCIRE_AGENT) ($$(stat -c%s $(OCIRE_AGENT)) bytes)"

$(OCIRE_AGENT): $(OCIRE_AGENT_SRC)
	@mkdir -p $(OCIRE_OUT)
	$(CC) -ffreestanding -fno-stack-protector -mno-red-zone -mno-sse \
	  -mno-mmx -mno-3dnow -fno-asynchronous-unwind-tables \
	  -Wall -Wextra -Werror -O2 -std=gnu11 \
	  -c $(OCIRE_AGENT_SRC) -o $(OCIRE_AGENT_OBJ)
	$(CC) -nostdlib -Wl,--build-id=none -T $(OC_ROOT)/src/L1/user.ld \
	  -o $@ $(OCIRE_AGENT_OBJ)
	strip --strip-debug $@

ocire-kernel: $(OCIRE_ELF)
	@echo "ocire-kernel: $(OCIRE_ELF) ($$(stat -c%s $(OCIRE_ELF)) bytes)"

ocire-iso: $(OCIRE_ISO)
	@echo "ocire-iso: $(OCIRE_ISO) ($$(stat -c%s $(OCIRE_ISO)) bytes)"

ocire-disk: $(OCIRE_ELF) $(OCIRE_AGENT) $(OC_ROOT)/tools/make_ocire_disk.sh $(OCIRE_DIR)/grub-dual.cfg.in
	bash $(OC_ROOT)/tools/make_ocire_disk.sh

ocire-run-bios: $(OCIRE_ISO)
	$(QEMU) -L $(QEMU_DATADIR) -L $(SEABIOS_DIR) \
	  -m 128M -cdrom $(OCIRE_ISO) -boot d \
	  -no-reboot -display none -serial stdio -monitor none -vga std

ocire-run-uefi: $(OCIRE_ISO)
	cp $(OVMF_FD) $(BUILD)/OVMF_OCIRE.fd
	$(QEMU) -L $(QEMU_DATADIR) -L $(SEABIOS_DIR) \
	  -m 128M -cdrom $(OCIRE_ISO) -boot d \
	  -no-reboot -display none -serial stdio -monitor none -vga std \
	  -drive if=pflash,format=raw,file=$(BUILD)/OVMF_OCIRE.fd

ocire-run-bios-gui: $(OCIRE_ISO)
	$(QEMU) -L $(QEMU_DATADIR) -L $(SEABIOS_DIR) \
	  -m 128M -cdrom $(OCIRE_ISO) -boot d \
	  -no-reboot -display gtk -serial stdio -monitor none -vga std

ocire-run-uefi-gui: $(OCIRE_ISO)
	cp $(OVMF_FD) $(BUILD)/OVMF_OCIRE.fd
	$(QEMU) -L $(QEMU_DATADIR) -L $(SEABIOS_DIR) \
	  -m 128M -cdrom $(OCIRE_ISO) -boot d \
	  -no-reboot -display gtk -serial stdio -monitor none -vga std \
	  -drive if=pflash,format=raw,file=$(BUILD)/OVMF_OCIRE.fd

ocire-test: $(OCIRE_ISO) $(OCIRE_ELF)
	python3 $(OC_ROOT)/tools/run_ocire_tests.py

ocire-dual-test: $(OCIRE_ISO) $(OCIRE_ELF) $(OC_ROOT)/tools/make_ocire_disk.sh
	bash $(OC_ROOT)/tools/make_ocire_disk.sh
	python3 $(OC_ROOT)/tools/run_ocire_dual_tests.py

# WP-02 group-4 battery: the full recovery shell (help/logread/syscheck/
# repair quick/repair full/return) against throwaway dual-disk copies,
# including a digest-damage case and a nuked-BPB full-repair case.
ocire-shell-test: $(OCIRE_ELF) $(OCIRE_AGENT) $(OC_ROOT)/tools/make_ocire_disk.sh
	bash $(OC_ROOT)/tools/make_ocire_disk.sh
	python3 $(OC_ROOT)/tools/run_ocire_shell_tests.py

# Header dependency tracking for the OCIRE objects.  The top-level
# Makefile includes only $(KERNEL_OBJ:.o=.d) (its line 448) - the
# OCIRE .d files were NEVER included, so a header change (e.g.
# ocire_fat.h) silently linked STALE objects compiled against the
# old struct layout.  Found live by the WP-02 battery: the mixed
# build read ocire_layout_t fields at shifted offsets and wrote
# garbage start LBAs into both MBRs.  (CI was never affected - it
# builds from a fresh clone - only local incremental builds.)
-include $(OCIRE_OBJ_C:.o=.d) $(OCIRE_AGENT_OBJ:.o=.d)

